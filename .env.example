# Required for the gpt-5.4-nano judge (via OpenRouter Responses API).
# Keep this file out of version control; copy to .env and fill in.
OPENROUTER_API_KEY=

# Optional. Only needed first time so HF can fetch Qwen/Qwen3-32B.
# After the snapshot is cached (~64 GB at ~/huggingface/hub/),
# subsequent runs work offline.
HF_TOKEN=
