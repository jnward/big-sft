# Secrets and env
.env
*.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Training artifacts
checkpoints/
logs/
wandb/

# Large data — only small metadata files tracked
data/*.jsonl
data/clean_*
data/hack_*

# Eval pipeline artifacts (scripts/eval/)
.venvs/
build/
tb-eval/checkpoints/
tb-eval

# But DO track job-level eval headlines (small JSONs) so the chart scripts
# can be reproduced offline. Per-trial dirs and trajectories stay ignored.
!build/
!build/jobs/
!build/jobs/*/
!build/jobs/*/result.json
!build/jobs/*/judge_scores*.json
!build/jobs/*/config.json
build/jobs/*/*__*/
build/eval-dataset/
build/merged/
build/logs/
build/vllm.pid

# Backups
*.bak

# Misc
tea_debug.log
*.log
